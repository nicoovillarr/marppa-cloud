# Server configuration
# Parent domain the auth cookies are scoped to. Must cover both the web host
# (cloud.marppa.com) and the API host (api.cloud.marppa.com); ".cloud.marppa.com"
# does, and is tighter than ".marppa.com". Only applied when cookies are secure.
COOKIES_DOMAIN=".cloud.marppa.com"
# Allowed browser origins (credentialed). The front proxies /api same-origin, so
# this mainly guards any direct cross-origin call. Include the real web origin.
CORS_URL="http://localhost:3000,https://cloud.marppa.com"
PORT=

# Force the Secure cookie flag on/off. Unset = follows NODE_ENV (secure in prod).
# In production (HTTPS on Render) leave unset so cookies are Secure + SameSite=None.
# COOKIE_SECURE="true"

# Security
JWT_SECRET="your_jwt_secret"

# Signs jobs enqueued for cloud-scripts to consume (BullMQ). Independent of
# JWT_SECRET; must match the value configured for cloud-scripts.
EVENT_QUEUE_HMAC_SECRET="your_event_queue_hmac_secret"

# Refresh-token / session lifetime in days. Sessions older than this are purged
# by the daily cleanup cron. Defaults to 7 when unset.
REFRESH_TOKEN_TTL_DAYS="7"

# Public self-registration. Disabled by default (the API is internet-reachable);
# set to "true" to open the POST /auth/register endpoint.
REGISTRATION_ENABLED="false"

# Exposes POST /system/reset, which wipes host state the database does not know
# about — and, in its hard variant, every host resource plus every resource row.
# Only members of the root company (a company with no parentCompanyId) can call
# it, and only while this is "true". Leave disabled outside a lab.
CAN_RESET_SYSTEM="false"

# Cloudflare Turnstile secret (captcha on login/register/reset-password).
# Leave empty in dev to skip captcha verification entirely.
TURNSTILE_SECRET=""

# Password-reset email delivery (Resend). Leave empty in dev: the reset link
# is logged to the server console instead of being emailed.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Base URL of the front-end, used to build the password-reset link.
# Falls back to the first CORS_URL entry, then http://localhost:3000.
FRONTEND_URL="http://localhost:3000"

# Database
# Aiven (and other managed PG) use a self-signed cert: paste the ca.pem contents
# into DB_CA. Empty = connect without a CA (local dev). Note: `prisma migrate
# deploy` / `prisma generate` use DATABASE_URL directly (not DB_CA), so add
# ?sslmode=require to the URL for those to connect to Aiven.
DATABASE_URL="postgres://<user>:<pass>@<host>:<port>/<db_name>?schema=<schema>&sslmode=require"
DB_CA=""

# Redis (cache)
VALKEY_HOST=""
VALKEY_PORT=
VALKEY_USERNAME=""
VALKEY_PASSWORD=""

# Redis (BullMQ queue — must point to same instance as cloud-scripts)
REDIS_URL=""
