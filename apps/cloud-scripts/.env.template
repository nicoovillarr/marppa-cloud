USE_STUBS=
USERNAME=""
BRIDGE_NAME=""

# Fibers available ports
MIN_PORT=
MAX_PORT=

# Redis (BullMQ)
REDIS_URL=""

# WebSocket configuration
WS_PORT=
# Interface the WS server binds to. Defaults to 127.0.0.1 (loopback only): in
# production expose it through a reverse proxy (Caddy) that terminates TLS.
# Set 0.0.0.0 only if a browser must reach it directly (not recommended).
WS_HOST="127.0.0.1"
JWT_SECRET=""
# Verifies jobs enqueued by the backend (BullMQ). Independent of JWT_SECRET;
# must match the value configured for the backend.
EVENT_QUEUE_HMAC_SECRET=""
# Comma-separated list of allowed browser origins for the WS handshake
# (e.g. https://cloud.marppa.com). Required — the server refuses to boot
# without it, and rejects any handshake with no Origin header at all.
# In production terminate TLS at a reverse proxy so clients connect over wss://.
WS_ALLOWED_ORIGINS=""

# 64-char hex string (32 bytes) used to encrypt Worker.consolePassword at
# rest (AES-256-GCM). Generate with: openssl rand -hex 32
# Rotating it orphans every already-encrypted password in the DB.
WORKER_CONSOLE_SECRET_KEY=""

# PostgreSQL connection string (Prisma)
DATABASE_URL=""
DB_CA=""

# Logger rotation
LOG_BACKUP_COUNT=5
LOG_DIR=
MAX_LOG_SIZE=10485760

# Ubuntu image domains whitelist (cloud images, not installer ISOs)
ALLOWED_IMAGE_DOMAINS=cloud-images.ubuntu.com

# How long to wait for a worker to finish its first boot before declaring it
# unreachable (ms). Cloud images typically need 30-60s.
WORKER_BOOT_TIMEOUT_MS=180000

# nftables base ruleset restored on mesh/system reset
NFTABLES_RESET_SOURCE=""