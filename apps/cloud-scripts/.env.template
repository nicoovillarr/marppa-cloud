USE_STUBS=
USERNAME=""
BRIDGE_NAME=""

# Fibers available ports
MIN_PORT=
MAX_PORT=

# Redis (BullMQ)
REDIS_URL=""

# WebSocket configuration
WS_PORT=
JWT_SECRET=""
# Comma-separated list of allowed browser origins for the WS handshake
# (e.g. https://cloud.marppa.com). Empty = allow any origin (dev only).
# In production terminate TLS at a reverse proxy so clients connect over wss://.
WS_ALLOWED_ORIGINS=""

# PostgreSQL connection string (Prisma)
DATABASE_URL=""
DB_CA=""

# Logger rotation
LOG_BACKUP_COUNT=5
LOG_DIR=
MAX_LOG_SIZE=10485760

# Ubuntu image domains whitelist (cloud images, not installer ISOs)
ALLOWED_IMAGE_DOMAINS=cloud-images.ubuntu.com

# How long to wait for a worker to finish its first boot before declaring it
# unreachable (ms). Cloud images typically need 30-60s.
WORKER_BOOT_TIMEOUT_MS=180000

# nftables base ruleset restored on mesh/system reset
NFTABLES_RESET_SOURCE=""