{
  "name": "marppa-cloud-scripts",
  "version": "2.0.0",
  "description": "Infrastructure event worker. Manages DNS, network, virtual machines, containers and more.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "dev:watch": "nodemon --watch src --ext ts --exec \"ts-node -r tsconfig-paths/register src/index.ts\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node -r ../../node_modules/ts-node/register/transpile-only -r ../../node_modules/tsconfig-paths/register --test src/critical-high.test.ts",
    "prisma:generate": "prisma generate",
    "start": "node -r ./scripts/register-aliases.js dist/index.js"
  },
  "keywords": [
    "marppa",
    "cloud",
    "scripts",
    "node"
  ],
  "author": "Marppa SAS",
  "license": "ISC",
  "dependencies": {
    "@marppa-cloud/api-types": "*",
    "@marppa-cloud/db": "*",
    "@marppa-cloud/shared": "*",
    "@prisma/client": "7.4.0",
    "awilix": "^13.0.3",
    "bullmq": "^5.0.0",
    "dotenv": "^16.5.0",
    "fastify": "^4.0.0",
    "ioredis": "^5.0.0",
    "jose": "^6.1.3",
    "node-pty": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.0.0",
    "nodemon": "^3.1.10",
    "prisma": "7.4.0",
    "tsup": "^8.0.0"
  }
}
